# ============================================================
# 乌托帮模型配置
#
# 这里填的是「开箱默认值」。跑起来之后在网页左侧「模型设置」里改会
# 存到 apps/server/data/llm.json,并盖住这里的值 —— 改完立即生效,不用重启。
#
# 完全不配也能跑:AI 接口返回 503,前端自动落内置模板,全流程仍然走得通。
# ============================================================

# 供应商:deepseek | openai | anthropic | moonshot | zhipu | dashscope | ollama | custom
LLM_PROVIDER=deepseek

# API Key(ollama 可留空)
LLM_API_KEY=

# 模型名。留空则用该供应商的默认模型
LLM_MODEL=deepseek-chat

# 接口地址。留空则用该供应商的官方地址;
# 接中转站时把 LLM_PROVIDER 设为 custom,这里填中转站给的地址(通常以 /v1 结尾)
LLM_BASE_URL=

# 设为 1 则锁死配置:网页设置页变只读,只认上面这些环境变量。
# 部署给团队用、不希望别人改 Key 时打开。
LLM_CONFIG_LOCKED=

# ============================================================
# 业务数据存储（默认 SQLite，无需填写）
# 网页左侧「数据存储」保存后写到 apps/server/data/storage.json。
# ============================================================

# sqlite | mysql
STORAGE_DRIVER=sqlite

# SQLite 文件路径；留空默认 apps/server/data/utobond.db
SQLITE_PATH=

# STORAGE_DRIVER=mysql 时填写
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=utobond
MYSQL_USER=utobond
MYSQL_PASSWORD=
MYSQL_SSL=0

# 设为 1 后数据存储页面只读，只认上述环境变量
STORAGE_CONFIG_LOCKED=

# 服务监听地址与端口。容器部署通常把 HOST 设为 0.0.0.0。
HOST=127.0.0.1
PORT=8787

# 前后端分域部署时，列出允许调用 API 的前端 Origin，多个用逗号分隔。
# 同域部署及默认 localhost:5173 开发环境无需填写。
UTOBOND_ALLOWED_ORIGINS=
