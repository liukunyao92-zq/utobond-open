{
  "name": "utobond",
  "private": true,
  "version": "0.3.0",
  "description": "乌托帮 UTOBANG — 先帮后托的开店服务台(monorepo)",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
